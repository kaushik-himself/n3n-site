{
  "name": "n3n-site",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "npm run build && wrangler deploy --keep-vars",
    "check:discovery": "python3 scripts/check-discovery.py",
    "predev": "python3 scripts/sync_substack.py",
    "prebuild": "python3 scripts/sync_substack.py",
    "test": "python3 -m unittest discover -s scripts -p \"test_*.py\" && node --test worker/*.test.js"
  },
  "dependencies": {
    "@astrojs/mdx": "^3.1.0",
    "astro": "^4.15.0"
  },
  "devDependencies": {
    "wrangler": "^4.147.0"
  }
}
