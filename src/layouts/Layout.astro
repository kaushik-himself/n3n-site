---
import '../styles/site.css';
interface Props { title: string; description?: string; redirectTo?: string; }
const { title, redirectTo, description = 'Neha Nupoor — writing on technology, systems, and ideas.' } = Astro.props;
const canonical = redirectTo ?? new URL(Astro.url.pathname, Astro.site);
const writing = Astro.url.pathname.startsWith('/writing');
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#f6f2e9" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={writing && Astro.url.pathname !== '/writing/' ? 'article' : 'website'} />
  <meta property="og:url" content={canonical} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title}</title>
  {redirectTo && <meta http-equiv="refresh" content={`0;url=${redirectTo}`} />}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400&display=swap" rel="stylesheet" />
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header wrap">
    <a class="wordmark" href="/" aria-label="Neha Nupoor, home">n3n<span aria-hidden="true">✳</span></a>
    <nav aria-label="Main navigation">
      <a href="/" aria-current={!writing ? 'page' : undefined}>Home</a>
      <a href="https://nupoorneha.substack.com" aria-current={writing ? 'page' : undefined}>Writing</a>
      <a href="https://reading.nehanupoor.com/" class="reading-nav">Reading room <span aria-hidden="true">↗</span></a>
    </nav>
  </header>
  <main id="main" class="wrap"><slot /></main>
  <footer class="site-footer wrap">
    <div><a class="footer-name" href="/">Neha Nupoor</a><p>Technology, systems, and ideas.</p></div>
    <div class="footer-right"><a href="https://reading.nehanupoor.com/">A little more reading <span aria-hidden="true">↗</span></a><p>© {new Date().getFullYear()} · n3n</p></div>
  </footer>
</body>
</html>
