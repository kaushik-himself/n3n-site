---
import '../styles/site.css';
interface Props { title: string; description?: string; redirectTo?: string; publishedTime?: Date; modifiedTime?: Date; }
const { title, redirectTo, publishedTime, modifiedTime, description = 'Neha Nupoor — writing on technology, systems, and ideas.' } = Astro.props;
const canonical = redirectTo ?? new URL(Astro.url.pathname, Astro.site);
const shareImage = new URL('/brand/n3n-og.png', Astro.site);
const writing = Astro.url.pathname.startsWith('/writing');
const isArticle = !!publishedTime;
const authorId = 'https://n3n.lol/#person';
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Person', '@id': authorId, name: 'Neha Nupoor', url: 'https://n3n.lol/', sameAs: ['https://github.com/neha-nupoor', 'https://nupoorneha.substack.com/'] },
    { '@type': 'WebSite', '@id': 'https://n3n.lol/#website', name: 'n3n.lol', url: 'https://n3n.lol/', publisher: { '@id': authorId } },
    { '@type': isArticle ? 'BlogPosting' : 'WebPage', '@id': String(canonical), url: String(canonical), name: title, description, isPartOf: { '@id': 'https://n3n.lol/#website' },
      ...(isArticle ? { headline: title.replace(/ — Neha Nupoor$/, ''), author: { '@id': authorId }, image: shareImage.href, mainEntityOfPage: { '@id': String(canonical) }, datePublished: publishedTime?.toISOString(), dateModified: (modifiedTime ?? publishedTime)?.toISOString() } : {}) },
  ],
};
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#f6f2e9" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={isArticle ? 'article' : 'website'} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={shareImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="n3n.lol, with Neha’s hand-drawn takeaway coffee cup." />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={shareImage} />
  <link rel="canonical" href={canonical} />
  {isArticle && <meta property="article:published_time" content={publishedTime?.toISOString()} />}
  {isArticle && <meta property="article:modified_time" content={(modifiedTime ?? publishedTime)?.toISOString()} />}
  <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />
  <link rel="icon" type="image/svg+xml" href="/brand/n3n-coffee-icon.svg" />
  <title>{title}</title>
  {redirectTo && <meta http-equiv="refresh" content={`0;url=${redirectTo}`} />}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400&display=swap" rel="stylesheet" />
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header wrap">
    <a class="wordmark" href="/" aria-label="Neha Nupoor, home">n3n<span aria-hidden="true">✳</span></a>
    <nav aria-label="Main navigation">
      <a href="/" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>Home</a>
      <a href="/writing/" aria-current={writing ? 'page' : undefined}>Writing</a>
      <a href="https://reading.nehanupoor.com/" class="reading-nav">Reading room <span aria-hidden="true">↗</span></a>
    </nav>
  </header>
  <main id="main" class="wrap"><slot /></main>
  <footer class="site-footer wrap">
    <div><a class="footer-name" href="/">Neha Nupoor</a><p>Technology, systems, and ideas.</p><nav class="footer-legal" aria-label="Legal"><a href="/privacy/">Privacy policy</a><a href="/terms/">Terms of service</a></nav></div>
    <div class="footer-right"><a href="https://reading.nehanupoor.com/">A little more reading <span aria-hidden="true">↗</span></a><p>© {new Date().getFullYear()} · n3n</p></div>
  </footer>
</body>
</html>
