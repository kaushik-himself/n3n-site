---
import DesktopLayout from '../../layouts/DesktopLayout.astro';
import { getCollection } from 'astro:content';
export async function getStaticPaths(){return (await getCollection('blog')).filter(post=>!post.data.draft).map(post=>({params:{slug:post.slug},props:{view:post.slug}}));}
const {view}=Astro.props;
---
<DesktopLayout view={view}/>
