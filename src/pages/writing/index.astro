---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog')).filter(post=>!post.data.draft).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
---
<Layout title="Writing — Neha Nupoor" description="Neha Nupoor's notes on technology, systems, and ideas.">
  <section class="archive-header"><p class="eyebrow">The notebook</p><h1>Thinking<br />on <em>paper.</em></h1><p>I write about technology, systems, and the ideas I keep coming back to.</p></section>
  <div class="archive-bar"><span>All writing</span><span>{posts.length} {posts.length===1?'entry':'entries'}</span></div>
  <div class="post-list">{posts.map((post,index)=><a class="post-row" href={`/writing/${post.slug}/`}><span class="post-number">{String(index+1).padStart(2,'0')}</span><div><h2>{post.data.title}</h2>{post.data.description && <p>{post.data.description}</p>}</div><div class="post-date"><time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric',timeZone:'UTC'})}</time><span aria-hidden="true">↗</span></div></a>)}</div>
  {posts.length===0 && <p class="empty-note">Nothing published here yet. The reading room is open.</p>}
  <aside class="archive-aside"><span class="eyebrow">Between entries</span><p>There’s more in the margins.</p><a class="text-link" href="https://reading.nehanupoor.com/">Visit the reading room <span aria-hidden="true">↗</span></a></aside>
</Layout>
